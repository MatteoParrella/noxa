# Configurazione di un ambiente online (staging o produzione) per scripts/configura_ambiente.sh.
# Copia in .env.staging (o .env.produzione), mai committato, e compila i valori qui sotto. I
# valori generati dallo script (password del worker, chiavi VAPID, segreto delle notifiche)
# vengono aggiunti in fondo allo stesso file, così una seconda esecuzione li riusa.
# Lo script li copia nei segreti di GitHub e di Supabase: dopo la configurazione il file serve
# solo per rieseguirla. Tienilo fuori da backup e cartelle sincronizzate.

AMBIENTE=staging

# --- Supabase (dashboard del progetto, regione UE, piano Free) ------------------------------
# Riferimento del progetto: Project Settings → General → Project ID (20 lettere minuscole).
SUPABASE_PROJECT_REF=
# Password del database scelta alla creazione del progetto.
SUPABASE_DB_PASSWORD=
# Token personale: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Indirizzo pubblico dell'app ---------------------------------------------------------
# Senza dominio: https://<CLOUDFLARE_PAGES_PROGETTO>.pages.dev. Con il dominio di D-01: per
# esempio https://staging.<dominio>.
URL_APP=

# --- Cloudflare ------------------------------------------------------------------------------
# Account ID: nella barra laterale della dashboard di Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
# Token API (My Profile → API Tokens → Create Custom Token) con i permessi di account
# "Cloudflare Pages: Edit" e "Workers R2 Storage: Edit".
CLOUDFLARE_API_TOKEN=
# Nome del progetto Pages (creato dallo script se manca).
CLOUDFLARE_PAGES_PROGETTO=noxa-staging
# Chiavi S3 di R2 (R2 → Manage API tokens → Create Account API token, "Object Read & Write"
# sui bucket <progetto>-mappe e <progetto>-backup creati dallo script). Si possono usare due
# token diversi per mappa e backup: in quel caso compila anche le righe R2_BACKUP_*.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# --- Cloudflare Turnstile (CAPTCHA della registrazione) -----------------------------------
# Il widget deve elencare tra gli hostname quello di URL_APP.
TURNSTILE_SITE_KEY=0x4AAAAAAFYS6AtK3v0U5RFV
TURNSTILE_SECRET=

# --- Email con Brevo (facoltativo finché manca il dominio) --------------------------------
# Senza questi valori Supabase usa il proprio server di prova, che spedisce solo agli
# indirizzi dei membri del progetto e poche email all'ora.
BREVO_SMTP_UTENTE=
BREVO_SMTP_CHIAVE=
EMAIL_MITTENTE=

# --- Backup cifrato (ADR-0025) ---------------------------------------------------------------
# Chiave pubblica age (age1…). Vuota: se `age-keygen` è installato lo script crea la coppia e
# salva la privata in ~/noxa-backup-<ambiente>.age.txt, da custodire fuori linea.
AGE_DESTINATARIO=

# --- Sveglia del worker (ADR-0031) ---------------------------------------------------------------
# Token fine-grained di GitHub (Settings → Developer settings → Fine-grained tokens): solo il
# repository di Noxa, permesso "Actions: Read and write" e nient'altro. Finisce nel Vault di
# Supabase: pg_cron lo usa per avviare worker.yml quando ci sono job in coda. Vuoto: vale solo
# lo schedule di GitHub, che può tardare di ore.
GITHUB_TOKEN_WORKER=
