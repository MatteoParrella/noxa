# Variabili d'ambiente di Noxa. Copia in .env (mai committato) e compila i valori.
# In staging e produzione i valori stanno nel gestore dei segreti di Vercel, Fly.io e Supabase.

# --- App web (pubbliche: finiscono nel bundle del client) ---------------------------------
# Solo valori pubblici con prefisso NEXT_PUBLIC_. Mai la chiave service_role (CLAUDE.md).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chiave anon stampata da `supabase start` (locale) o dalla dashboard del progetto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL del file PMTiles nel bucket pubblico `mappe` (ADR-0016). Glyphs e sprites stanno nello
# stesso bucket, in mappe/assets/.
NEXT_PUBLIC_MAPPA_PMTILES_URL=http://127.0.0.1:54321/storage/v1/object/public/mappe/milano-brianza.pmtiles
# Chiave pubblica Cloudflare Turnstile per il CAPTCHA di registrazione.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# DSN Sentry (regione UE) dell'app; vuoto in locale per disattivare.
NEXT_PUBLIC_SENTRY_DSN=
# Chiave pubblica VAPID per il Web Push (Fase 2).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Worker (segrete) -----------------------------------------------------------------------
AMBIENTE=locale
# Connessione con il ruolo limitato noxa_worker (DATA_MODEL.md §1). In locale la password è
# impostata da supabase/seed.sql; il docker-compose costruisce l'URL da questa variabile.
WORKER_DB_PASSWORD_LOCALE=sviluppo-locale
WORKER_DATABASE_URL=postgresql://noxa_worker:sviluppo-locale@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Usata SOLO dal client Storage del worker per i bucket dei flyer (ADR-0003).
SUPABASE_SERVICE_ROLE_KEY=
# Claude API per l'estrazione dei flyer (ADR-0007, D-03).
ANTHROPIC_API_KEY=
CLAUDE_MODELLO_FLYER=claude-opus-5-5
FLYER_LATO_MAX_PX=1568
FLYER_BUDGET_GIORNALIERO_EUR=10
# Instagram Graph API, Business Discovery (EVENT_INGESTION.md §2.5).
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=
META_ACCESS_TOKEN=
# Google Places, solo per il bootstrap dei locali (EVENT_INGESTION.md §2.1).
GOOGLE_PLACES_API_KEY=
# Identità dello scraper (EVENT_INGESTION.md §2.4).
SCRAPER_USER_AGENT=NoxaBot/1.0 (+https://noxa.app/bot)
SCRAPER_INTERVALLO_MINIMO_S=5
SCRAPER_PAGINE_MASSIME=50
# Esecutori paralleli della coda in ogni istanza del worker.
CODA_CONCORRENZA=4
SENTRY_DSN_WORKER=
LOG_FORMATO=json

# --- Edge Functions (segrete, impostate con `supabase secrets set`) ------------------------
FCM_PROGETTO_ID=
FCM_CREDENZIALI_JSON=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sicurezza@noxa.app
